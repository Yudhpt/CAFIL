# Copy these values into your shell environment before running CAFIL.
# Keep this file as a template; do not place private paths or credentials in Git.
CAFIL_DATA_ROOT=/absolute/path/to/datasets
CAFIL_OUTPUT_ROOT=/absolute/path/to/cafil_outputs
CAFIL_DINO_HOME=/absolute/path/to/torch_cache
CAFIL_FORCE_CPU=0
